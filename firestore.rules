rules_version = '2';

// Regras de segurança do Firestore.
// Para aplicar: Console do Firebase > Firestore Database > Regras > colar este arquivo > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function ehAdmin() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
    }

    // usuarios/{uid}: { nome, email, perfil: 'admin' | 'professor', criadoEm }
    match /usuarios/{uid} {
      // Cada um lê o próprio perfil; o admin lê todos (tela Usuários)
      allow read: if logado() && (request.auth.uid == uid || ehAdmin());
      // Só o admin cadastra, altera ou remove usuários (ninguém muda o próprio perfil)
      allow create, update: if ehAdmin()
        && request.resource.data.perfil in ['admin', 'professor'];
      allow delete: if ehAdmin();
    }
  }
}
